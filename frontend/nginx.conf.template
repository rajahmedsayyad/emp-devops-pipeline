server {
  listen 80;
  root /usr/share/nginx/html;
  index index.html;

  resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

  location /api/ {
    set $upstream http://${BACKEND_HOST}:8080;
    rewrite ^/api/(.*)$ /$1 break;
    proxy_pass $upstream;
  }

  location / {
    try_files $uri /index.html;
  }
}